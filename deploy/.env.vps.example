# Production VM — copy to /opt/capex-deploy/.env (NEVER commit filled file).
# One .env for both containers (monorepo). Do NOT set CAPEX_SERVICE_* — BFF → monolith.
#
# Siloam DEV (DNS A → 10.201.130.4):
#   http://dev-capexpro.siloamhospitals.com      → web :8080
#   http://dev-capexpro-api.siloamhospitals.com  → api :8082 (optional; browser uses FE /api BFF)
# After TLS: use https://… and set FORCE_HTTPS=1 (or COOKIE_SECURE=1).
#
# Local DB (no Tencent tunnel at runtime):
#   One-shot (recommended on Siloam VM):
#     docker compose -f deploy/docker-compose.siloam.yml --env-file deploy/.env.compose up -d --build
#   Or split:
#     docker compose -f docker-compose.db.yml --env-file .env up -d
#   SUPABASE_URL must be Docker DNS → http://capex-postgrest
#   NEVER http://127.0.0.1:54321 from inside capex-api (that is the API container itself).
#   BFF→API: NEXT_PUBLIC_CAPEXBE_URL=http://capex-api:3001  (API PORT inside container = 3001)
#
# Do NOT set CAPEX_SERVICE_AUTH_URL on web unless CAPEX_AUTH_USE_LEAF=1
# (SSO/session must stay on monolith capex-api by default).

NODE_ENV=production
# API only (capex-api). capex-web overrides to PORT=3000 in docker-compose.siloam.yml
# because both services load this same env_file.
PORT=3001

# password | sso | both
CAPEX_AUTH_MODE=sso
# FE mirror (capex-web / Next) — Super Admin create-user UX
NEXT_PUBLIC_CAPEX_AUTH_MODE=sso
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=siloamhospitals.com

# HTTP before TLS — keep cookies from forcing https://
# COOKIE_SECURE=0
# FORCE_HTTPS=0
# After TLS: FORCE_HTTPS=1 / COOKIE_SECURE=1

# --- Local Postgres + PostgREST (compose: docker-compose.db.yml) --------------
USE_VPS_POSTGRES=1
POSTGRES_DB=capex
POSTGRES_USER=capex_app
POSTGRES_PASSWORD=CHANGE_ME
# supabase-js talks to PostgREST gateway on Docker network `capex-db`
SUPABASE_URL=http://capex-postgrest
# BFF (capex-web) → API — must match container PORT (Dockerfile EXPOSE 3001)
NEXT_PUBLIC_CAPEXBE_URL=http://capex-api:3001
CAPEXBE_URL=http://capex-api:3001
# JWT secret must match PostgREST PGRST_JWT_SECRET (same value)
SUPABASE_JWT_SECRET=CHANGE_ME_LONG_RANDOM
# Keys for supabase-js (role claim = capex_app). Generate:
#   ./deploy/postgres/generate-vps-jwt-keys.sh
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional direct SQL tooling from host (not used by API at runtime)
DATABASE_URL=postgresql://capex_app:CHANGE_ME@127.0.0.1:5433/capex

JWT_ACCESS_SECRET=CHANGE_ME_LONG_RANDOM

CORS_ORIGINS=https://dev-capexpro.siloamhospitals.com,http://dev-capexpro.siloamhospitals.com
FRONTEND_URL=https://dev-capexpro.siloamhospitals.com
OAUTH_CALLBACK_PATH=/api/auth/azure/callback

# Azure Entra (direct OAuth — no Supabase Auth broker)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Redis — use Docker service/network name, NOT 127.0.0.1 from inside API
REDIS_URL=redis://capex-redis:6379
COMPOSE_REDIS_NETWORK=capex-redis_default

PUBLIC_ID_SALT=
ENABLE_AUTH_AUDIT_LOG=true
ALLOWED_EMAIL_DOMAINS=siloamhospitals.com
