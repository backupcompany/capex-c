# VPS production — capex-api monolith (copy to /opt/capex-deploy/.env)
# Do NOT set CAPEX_SERVICE_* — BFF routes all traffic to this API.
# capex-web: JWT_ACCESS_SECRET must match; NEXT_PUBLIC_* baked in CI image.

NODE_ENV=production
PORT=8082

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

JWT_ACCESS_SECRET=

CORS_ORIGINS=https://capex.siloamhospitals.com
FRONTEND_URL=https://capex.siloamhospitals.com

REDIS_URL=redis://127.0.0.1:6379

# Mask user id on wire (must match capex-web NEXT_PUBLIC_PUBLIC_ID_SALT — generate: node scripts/generate-public-id-salt.mjs)
PUBLIC_ID_SALT=

ENABLE_AUTH_AUDIT_LOG=true
ALLOWED_EMAIL_DOMAINS=siloamhospitals.com
