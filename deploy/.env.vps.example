# Production VM — copy to /opt/capex-deploy/.env (NEVER commit filled file).
# One .env for both containers (monorepo). Do NOT set CAPEX_SERVICE_* — BFF → monolith.
#
# Public URLs (Caddy):
#   https://capex.cgp-ai.com      → web :8080
#   https://capex-api.cgp-ai.com  → api :8082
#
# NEXT_PUBLIC_* for web are baked in CI (deploy-web.yml), not from this file.

NODE_ENV=production
PORT=8082

# password | sso | both — flip to sso when Microsoft login go-live
CAPEX_AUTH_MODE=password

# --- DB (postgres-core on database-net) --------------------------------------
# Prefer DATABASE_URL. Host = docker DNS name, NOT 127.0.0.1.
DATABASE_URL=postgresql://USER:PASSWORD@postgres-core:5432/capex
# Optional split form (if app reads these):
# DB_HOST=postgres-core
# DB_PORT=5432
# DB_NAME=capex
# DB_USER=
# DB_PASSWORD=

# --- Supabase (Auth OAuth broker; optional if password-only) -----------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

JWT_ACCESS_SECRET=

CORS_ORIGINS=https://capex.cgp-ai.com
FRONTEND_URL=https://capex.cgp-ai.com

# Redis on shared network (container name cgp-redis) — NOT 127.0.0.1 from inside Docker
REDIS_URL=redis://cgp-redis:6379

# Mask user id on wire (must match FE NEXT_PUBLIC_PUBLIC_ID_SALT if used)
PUBLIC_ID_SALT=

ENABLE_AUTH_AUDIT_LOG=true
ALLOWED_EMAIL_DOMAINS=siloamhospitals.com

# OAuth return path on FE (Supabase redirect allowlist)
OAUTH_CALLBACK_PATH=/auth/callback
