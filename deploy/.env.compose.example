# Shared secrets for deploy/docker-compose.siloam.yml
# Generate from local env: make compose-env (optional)

# Host curl to PostgREST on the VM: http://127.0.0.1:54321
# Inside capex-api container compose FORCES: http://capex-postgrest (do not rely on this line)
SUPABASE_URL=http://capex-postgrest
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
JWT_ACCESS_SECRET=

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://redis:6379

# Mask user id on wire — Nest/BE only (never NEXT_PUBLIC_*). Default in code: capex-siloam-public-id-v2
PUBLIC_ID_SALT=
