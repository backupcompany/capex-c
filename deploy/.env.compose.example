# Shared secrets for deploy/docker-compose.microservices.yml (optional — NOT production VPS default)
# Production VPS uses deploy/.env.vps.example (monolith only).
# Generate from local env: make compose-env

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
JWT_ACCESS_SECRET=

CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://redis:6379

# Mask user id on wire — set same value on capex-web (NEXT_PUBLIC_PUBLIC_ID_SALT) and all BE services (PUBLIC_ID_SALT)
PUBLIC_ID_SALT=
