# CAPEX Postgres on VPS — SSH tunnel (shareable template, NO secrets)
# Copy: cp deploy/postgres/postgres-ssh.env.example deploy/postgres/postgres-ssh.local.env
# Password: ask admin OR  ssh capex-vps 'grep PGPASSWORD /opt/capex-deploy/postgres-ssh.env'
#
# 1) SSH config (~/.ssh/config):
#      Host capex-vps
#        HostName 43.134.46.149
#        User ubuntu
#
# 2) Terminal A — tunnel (keep open):
#      ssh -N -L 5433:127.0.0.1:5432 capex-vps
#
# 3) Terminal B — load env + connect:
#      set -a && source deploy/postgres/postgres-ssh.local.env && set +a
#      psql "$DATABASE_URL"

SSH_TUNNEL_CMD="ssh -N -L 5433:127.0.0.1:5432 capex-vps"

PGHOST=127.0.0.1
PGPORT=5433
PGUSER=capex_app
PGDATABASE=capex
PGPASSWORD=ASK_ADMIN_OR_VPS_SECRETS

DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=capex
DB_USER=capex_app

# Fill after PGPASSWORD is set (URL-encode special chars in password if needed)
DATABASE_URL=postgresql://capex_app:ASK_ADMIN_OR_VPS_SECRETS@127.0.0.1:5433/capex
