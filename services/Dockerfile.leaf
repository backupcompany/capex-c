# Parameterized leaf service image — build from monorepo root:
#   docker build -f services/Dockerfile.leaf --build-arg SERVICE=capex-notifications --build-arg PORT=3002 .
ARG SERVICE=capex-notifications
ARG PORT=3002

FROM node:22-alpine

ARG SERVICE
ARG PORT

WORKDIR /app

COPY capexbe/package*.json ./capexbe/
COPY packages/capex-auth-core/package.json ./packages/capex-auth-core/
COPY services/${SERVICE}/package*.json ./services/${SERVICE}/

RUN cd capexbe && npm ci --omit=dev \
  && cd ../services/${SERVICE} && npm ci --omit=dev --ignore-scripts

COPY capexbe/src ./capexbe/src
COPY capexbe/tsconfig*.json ./capexbe/
COPY capexbe/nest-cli.json ./capexbe/
COPY packages/capex-auth-core ./packages/capex-auth-core
COPY services/${SERVICE} ./services/${SERVICE}

WORKDIR /app/services/${SERVICE}
RUN node scripts/link-nest-deps.mjs \
  && npm run build \
  && node scripts/postbuild.mjs \
  && node scripts/link-nest-deps.mjs

ENV NODE_ENV=production
ENV PORT=${PORT}

EXPOSE ${PORT}

CMD ["node", "-r", "@swc-node/register", "dist/src/main.js"]
