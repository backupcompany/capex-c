{
  "name": "capex-executive-summary",
  "version": "0.1.0",
  "private": true,
  "description": "CAPEX executive summary leaf (Phase 7c)",
  "scripts": {
    "postinstall": "node scripts/link-nest-deps.mjs",
    "build": "nest build && node scripts/postbuild.mjs",
    "build:full": "npm install --ignore-scripts && nest build && node scripts/postbuild.mjs && node scripts/link-nest-deps.mjs",
    "start": "nest start",
    "start:dev": "node scripts/dev-watch.mjs",
    "start:prod": "node -r @swc-node/register -r tsconfig-paths/register dist/src/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.build.json"
  },
  "dependencies": {
    "@capex/auth-core": "file:../../packages/capex-auth-core",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/throttler": "^6.5.0",
    "@supabase/supabase-js": "^2.103.3",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.6.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "win-ca": "^3.5.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@swc-node/register": "^1.12.1",
    "@swc/cli": "^0.7.10",
    "@swc/core": "^1.15.46",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^24.0.0",
    "@typescript/typescript6": "6.0.2",
    "tsx": "^4.23.1",
    "typescript": "6.0.2"
  }
}
