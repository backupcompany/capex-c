# =============================================================================
# CAPEX Frontend (capex-apps) — copy to .env.local
#   cp .env.example .env.local
# Restart `npm run dev` after changes.
# =============================================================================

# --- Backend BFF (capexbe monolith :3001) — REQUIRED --------------------------
# Local: http://localhost:3001
# Prod:  https://your-api.example.com (no trailing slash)
NEXT_PUBLIC_CAPEXBE_URL=http://localhost:3001

# Server-side proxy fallback (optional; NEXT_PUBLIC_CAPEXBE_URL is preferred)
# CAPEXBE_URL=http://localhost:3001

# Edge middleware JWT verify — same value as capexbe JWT_ACCESS_SECRET (never NEXT_PUBLIC_*)
# Enables signature check at Next.js edge before /api/be proxy. Optional in local dev.
# JWT_ACCESS_SECRET=change-me-use-openssl-rand-base64-48

# --- Security flags (recommended) --------------------------------------------
NEXT_PUBLIC_USE_BACKEND_SESSION=true

# Cookie Secure / CSP HTTPS upgrade — HTTP LAN/domain before TLS:
# COOKIE_SECURE=0
# After TLS (or when x-forwarded-proto=https): leave unset, or FORCE_HTTPS=1
# FORCE_HTTPS=0

# Auth mode: password | sso | both (mirror capexbe CAPEX_AUTH_MODE)
# sso = Microsoft only (production) | password = form only | both = both
NEXT_PUBLIC_CAPEX_AUTH_MODE=sso

# Mirror capexbe ALLOWED_EMAIL_DOMAINS — Super Admin create-user UX validation
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=siloamhospitals.com

# Legacy toggles (prefer CAPEX_AUTH_MODE):
# NEXT_PUBLIC_ENABLE_AZURE_SSO=true
# NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=true  # emergency override only

# Public user id tokens are encoded on Nest only (PUBLIC_ID_SALT). Never NEXT_PUBLIC_*.

# IP allowlist — optional dev/demo only; leave unset in production (allow all)
# IP_ALLOWLIST=203.0.113.10,203.0.113.11

# --- Optional / dev only -----------------------------------------------------
# Demo LAN — relaxed rate limits / CORS (dev only)
# Demo door (local only). Production: leave unset or false.
# NEXT_PUBLIC_CAPEX_DEMO_MODE=false
# NEXT_PUBLIC_CAPEX_DEMO_MODE=true
# NEXT_PUBLIC_AUTH_DEBUG=true
# NEXT_PUBLIC_PROJECT_LIST_DEBUG=1

# AI (Gemini) — server-only if enabled; NEVER NEXT_PUBLIC_GEMINI_API_KEY
# GEMINI_API_KEY=

# Azure OAuth + Supabase Auth gateway — configure on capexbe ONLY (never NEXT_PUBLIC_*)
# See capexbe/.env.example (SUPABASE_URL, SUPABASE_ANON_KEY, FRONTEND_URL)

# --- Microservices (optional strangler fig) ----------------------------------
# Leave ALL unset for monolith (default). When set, BFF routes that prefix to the leaf.
# CAPEX_SERVICE_NOTIFICATIONS_URL=http://127.0.0.1:3002
# CAPEX_SERVICE_AUDIT_URL=http://127.0.0.1:3003
# CAPEX_SERVICE_BACKUP_URL=http://127.0.0.1:3004
# CAPEX_SERVICE_CONFIGURATION_URL=http://127.0.0.1:3005
# CAPEX_SERVICE_MOM_DAILY_SUMMARY_URL=http://127.0.0.1:3006
# CAPEX_SERVICE_ASSET_TIMELINE_URL=http://127.0.0.1:3007
# CAPEX_SERVICE_DUPLICATE_DETECTION_URL=http://127.0.0.1:3008
# CAPEX_SERVICE_USER_ADMIN_URL=http://127.0.0.1:3009
# CAPEX_SERVICE_PROCUREMENT_URL=http://127.0.0.1:3010
# CAPEX_SERVICE_FS_URL=http://127.0.0.1:3011
# CAPEX_SERVICE_MONITORING_URL=http://127.0.0.1:3012
# CAPEX_SERVICE_REPORTING_URL=http://127.0.0.1:3013
# CAPEX_SERVICE_EXECUTIVE_SUMMARY_URL=http://127.0.0.1:3014
# CAPEX_SERVICE_TASKS_URL=http://127.0.0.1:3015
# CAPEX_SERVICE_CORE_URL=http://127.0.0.1:3016
# CAPEX_SERVICE_SMART_MIGRATION_URL=http://127.0.0.1:3017
# CAPEX_SERVICE_AUTH_URL=http://127.0.0.1:3018
