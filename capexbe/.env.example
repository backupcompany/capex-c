# =============================================================================
# CAPEX Backend (capexbe) — copy to .env
#   cp .env.example .env
# =============================================================================

NODE_ENV=development
PORT=3001

# --- Supabase (Dashboard → Project Settings → API) ---------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# REQUIRED in production — server-side DB access + auth_sessions writes
# NEVER expose this in frontend / NEXT_PUBLIC_* / Docker build-args for capex-web
SUPABASE_SERVICE_ROLE_KEY=

# REQUIRED for POST /auth/exchange
# Dashboard → Project Settings → API → JWT Settings → JWT Secret
# Do NOT reuse JWT_ACCESS_SECRET or anon key here.
SUPABASE_JWT_SECRET=

# --- Backend session JWT (httpOnly cookie capex_access) ------------------------
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-use-openssl-rand-base64-48
# Optional fallback only if JWT_ACCESS_SECRET unset: JWT_SECRET=

# --- CORS (comma-separated, no spaces) ---------------------------------------
# Local dev:
CORS_ORIGINS=http://localhost:3000
# Siloam DEV (HTTP until TLS; DNS → 10.201.130.4):
# CORS_ORIGINS=http://dev-capexpro.siloamhospitals.com,http://10.201.130.4
# FRONTEND_URL=http://dev-capexpro.siloamhospitals.com
# Production (Siloam — SSO internal, no IP allowlist):
# CORS_ORIGINS=https://capex.siloamhospitals.com
# FRONTEND_URL=https://capex.siloamhospitals.com

# Cookie Secure / CSP HTTPS upgrade — do NOT tie to NODE_ENV alone.
# HTTP LAN/domain: leave unset or COOKIE_SECURE=0. After TLS: FORCE_HTTPS=1
# COOKIE_SECURE=0
# FORCE_HTTPS=0

# Public frontend origin — OAuth callback redirect (defaults to first CORS_ORIGIN)
# FRONTEND_URL=http://localhost:3000

# Add to Supabase Dashboard → Auth → URL Configuration → Redirect URLs:
#   {FRONTEND_URL}{OAUTH_CALLBACK_PATH}
#   e.g. http://localhost:3000/api/auth/azure/callback
#   e.g. https://capex.cgp-ai.com/auth/callback

# --- Security / audit ----------------------------------------------------------
ENABLE_AUTH_AUDIT_LOG=true

# Auth mode: password | sso | both  (password = form only; sso = Microsoft only)
CAPEX_AUTH_MODE=sso

# Production SSO — restrict to corporate email domain (required for Siloam):
ALLOWED_EMAIL_DOMAINS=siloamhospitals.com
# Dev escape hatch only: ALLOWED_EMAIL_DOMAINS=*
# Mirror on FE for create-user UX: NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=siloamhospitals.com

# OAuth callback on FE (must match Azure App Redirect URI)
# OAUTH_CALLBACK_PATH=/api/auth/azure/callback

# Azure Entra — direct OAuth (no Supabase Auth broker)
# AZURE_TENANT_ID=5db61118-5d18-4bfd-97fd-bc52cdad9c51
# AZURE_CLIENT_ID=c0946df4-4494-48d6-8091-eb4a5c18a316
# AZURE_CLIENT_SECRET=
# Azure Redirect URI (Web) = {FRONTEND_URL}{OAUTH_CALLBACK_PATH}
#   e.g. http://localhost:3000/api/auth/azure/callback
#   e.g. https://dev-capexpro.siloamhospitals.com/api/auth/azure/callback

# IP allowlist — optional dev/demo only; leave unset in production (allow all)
# IP_ALLOWLIST=203.0.113.10,203.0.113.11

# Demo LAN — password login + allow 192.168.x.x CORS (dev only)
# Demo / one-click enter — production: false or unset
# CAPEX_DEMO_MODE=false
# CAPEX_DEMO_MODE=true
# LOCAL_DEV_ENTER_EMAIL=wahyu.pratama760001@siloamhospitals.com

# --- VPS Postgres mode (Nest reads these; DB connection is PostgREST URL above) -
# Nest does NOT use DATABASE_URL / PGHOST / PGPASSWORD — those are for scripts only:
#   deploy/postgres/postgres-ssh.env.example
#   ./deploy/postgres/ensure-vps-dev.sh + run-postgrest-local.sh
# USE_VPS_POSTGRES=1
# DEMO_LOGIN_EMAIL=demo@capex.local
# DEMO_LOGIN_PASSWORD=demo123

# SSO-only production: password login disabled when NODE_ENV=production. Override:
# DISABLE_PASSWORD_LOGIN=false

# --- Optional ------------------------------------------------------------------
# Corporate TLS (Windows proxy / custom CA)
# SUPABASE_CA_CERT_PATH=/path/to/corporate-root-ca.pem

# Redis shared cache — start locally: make redis-up
# Also backs auth rate limit, account lockout, and global API throttler (400/min)
REDIS_URL=redis://127.0.0.1:6379

# Asset INSERT → Power Automate (Nest). Canonical when Postgres has no pg_net (Siloam).
# POWER_AUTOMATE_ASSET_WEBHOOK_URL=https://....powerplatform.com/.../invoke?...

# PERF_CACHE_LOG=1
# PROJECT_LIST_PIPELINE_LOG=1

# HTTP performance (optional)
# COMPRESSION_THRESHOLD=1024
# SLOW_REQUEST_MS=1000
# REQUEST_METRICS_LOG=0

# GET /metrics — localhost-only by default in prod; remote scrape needs header:
# curl -H "X-Metrics-Token: $METRICS_SECRET" https://host/metrics
# METRICS_SECRET=
# METRICS_PUBLIC=1   # dev only — never set in production

# Auth lockout — 5 failures / 15 min → 15 min block (email+IP key)
# AUTH_LOCKOUT_MAX_FAILURES=5
# AUTH_LOCKOUT_WINDOW_MS=900000
# AUTH_LOCKOUT_MS=900000
# AUTH_LOCKOUT_DISABLED=1   # dev/demo only

# Hashids salt for public user refs (Nest only — never NEXT_PUBLIC_* / never ship to browser)
# PUBLIC_ID_SALT=capex-siloam-public-id-v2

# Logging — async pino (nestjs-pino)
# LOG_LEVEL=info
# PINO_PRETTY=0
