# Cursor IDE — local only (rules/skills/MCP stay on disk, not in repo)
.cursor/

# Local-only docs & diagrams — keep on disk, not in GitHub
# (RELEASES.md + README.md are tracked — release notes + version guide)
/DEPLOY.md
/SECURITY.md
/docs/
/capex-apps/TUTORIAL_PENGGUNA.md

# Local-only bootstrap (make env) — optional on disk
/run
/run.cmd
/run.ps1
/scripts/setup-env.sh
**/.cursorrules

# OS
.DS_Store

# Env secrets (all apps) — never commit credentials
.env
.env.*
.env.local
.env.*.local
**/.env
**/.env.*
**/.env.local
**/.env.*.local
!**/.env.example
!**/.env.*.example
!.env.example

# Dependencies
**/node_modules/

# Build outputs
**/.next/
**/out/
**/dist/
**/build/
**/.netlify/
**/coverage/

# Logs & debug
**/*.log
**/.pnpm-debug.log*

# TypeScript
**/*.tsbuildinfo
**/next-env.d.ts

# Ops data — never commit credentials or user imports
**/scripts/*.data.json
**/scripts/*-users.json
# IDE
**/.idea/
**/.vscode/*
!**/.vscode/settings.json
