{
  "name": "@capex/auth-core",
  "version": "0.1.0",
  "private": true,
  "description": "Shared auth module for CAPEX monolith + leaf services",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./auth-core.module": {
      "types": "./dist/auth-core.module.d.ts",
      "default": "./dist/auth-core.module.js"
    },
    "./auth-request-context": {
      "types": "./dist/auth-request-context.d.ts",
      "default": "./dist/auth-request-context.js"
    },
    "./constants/auth-policy": {
      "types": "./dist/constants/auth-policy.d.ts",
      "default": "./dist/constants/auth-policy.js"
    },
    "./constants/enterprise-roles": {
      "types": "./dist/constants/enterprise-roles.d.ts",
      "default": "./dist/constants/enterprise-roles.js"
    },
    "./types/resolved-auth-context": {
      "types": "./dist/types/resolved-auth-context.d.ts",
      "default": "./dist/types/resolved-auth-context.js"
    }
  },
  "scripts": {
    "typecheck": "node ../../capexbe/node_modules/typescript/bin/tsc --noEmit -p tsconfig.build.json",
    "build": "node ../../capexbe/node_modules/typescript/bin/tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@supabase/supabase-js": "^2.103.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0"
  }
}
